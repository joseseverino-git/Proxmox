# =================================================================
# Proxmox Spotlight Dashboard - Environment Configuration
# =================================================================

# URL / IP of your Proxmox VE node or cluster (e.g. https://192.168.1.100:8006)
PVE_HOST=https://192.168.1.100:8006

# Authentication type: 'token' (recommended) or 'password'
AUTH_TYPE=token

# Proxmox User Realm (recommended: dedicated monitoring user in 'pve' realm)
# Example: monitoring@pve or root@pam
PVE_USER=monitoring@pve

# Proxmox API Token Name (used if AUTH_TYPE=token)
PVE_TOKEN_NAME=spotlight

# Proxmox API Token Secret UUID (generated once when token is created in PVE)
# Example: a1b2c3d4-e5f6-7890-abcd-ef1234567890
PVE_TOKEN_VALUE=your-token-secret-uuid-here

# Proxmox Password (used if AUTH_TYPE=password)
PVE_PASSWORD=

# SSL Certificate verification (Set to 'false' if using default self-signed PVE certificate)
PVE_VERIFY_SSL=false

# API Request Timeout in seconds
PVE_TIMEOUT=6.0

# Telemetry Cache TTL in seconds (prevents overloading PVE API with frequent requests)
CACHE_TTL_SECONDS=5

# HTTP Port to expose on Raspberry Pi host
PORT=8080

# Demo Mode: Set to 'true' to simulate realistic multi-node Proxmox cluster data without connecting
DEMO_MODE=false

# Fallback to Demo: If false (recommended), shows connection errors & troubleshooting screen instead of mock servers
FALLBACK_TO_DEMO=false

# --- Notificaciones y Alertas por Correo Electrónico (Gmail SMTP) ---
# Habilitar o deshabilitar el envío de alertas automáticas (true / false)
ALERT_EMAIL_ENABLED=false

# Correo de destino que recibirá las alertas urgentes
ALERT_EMAIL_TO=

# Configuración del servidor SMTP de Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=apps.monitor.lnx@gmail.com
SMTP_PASSWORD=uoilwckixdoemkfo
SMTP_USE_TLS=true

# Minutos de espera entre alertas del mismo incidente para evitar spam (cooldown)
ALERT_COOLDOWN_MINUTES=30
